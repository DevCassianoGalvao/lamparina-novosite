# Copie este arquivo para .env e preencha os valores.
# De preferência coloque o .env UM NÍVEL ACIMA da pasta pública do site
# (o api/contato.php procura lá primeiro e depois na raiz do site).

# Chave da API do Brevo (Configurações > SMTP & API > Chaves de API)
BREVO_API_KEY=

# Remetente verificado no Brevo
MAIL_FROM_EMAIL=noreply@lamparinahub.com
MAIL_FROM_NAME=Lamparina

# Quem recebe os contatos do formulário
MAIL_TO_EMAIL=contatoagencialamparina@gmail.com
MAIL_TO_NAME=Lamparina Hub

# Começo do assunto do e-mail (o nome e a empresa entram depois)
MAIL_SUBJECT_PREFIX=Novo contato pelo site

# Opcional: domínios que podem enviar o formulário, separados por vírgula
# Deixe em branco pra aceitar de qualquer origem
ALLOWED_ORIGINS=https://www.lamparinahub.com,https://lamparinahub.com
